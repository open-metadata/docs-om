{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prs", "verdict", "reason", "suggested_title", "breaking"],
        "properties": {
          "prs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+#[0-9]+$"}},
          "verdict": {"type": "string", "enum": ["confirmed", "ruled_out", "needs_a_look", "held"]},
          "reason": {"type": "string", "maxLength": 700},
          "suggested_title": {"type": "string", "maxLength": 120},
          "breaking": {"type": "boolean"}
        }
      }
    }
  }
}
